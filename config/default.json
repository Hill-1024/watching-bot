{
  "$comment": "watching-bot 主配置。apiKey 从环境变量 WATCHING_BOT_API_KEY 读取,勿写入本文件。",
  "model": {
    "provider": "watching-bot-custom",
    "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
    "model": "glm-4.7",
    "apiKeyEnv": "WATCHING_BOT_API_KEY",
    "contextWindow": 128000
  },
  "time": {
    "timeScale": 1,
    "tickRealMs": 1000
  },
  "modules": [
    "qq",
    "builtin"
  ],
  "moduleConfig": {
    "napcat": {
      "url": "ws://127.0.0.1:3001",
      "token": "",
      "selfId": 0,
      "dbPath": "data/modules/napcat.db",
      "memeDir": "data/modules/memes",
      "sendMinIntervalMs": 2500,
      "sendJitterMs": 1500
    },
    "snowluma": {
      "url": "ws://127.0.0.1:3001",
      "token": "",
      "selfId": 0,
      "dbPath": "data/modules/napcat.db",
      "memeDir": "data/modules/memes",
      "sendMinIntervalMs": 2500,
      "sendJitterMs": 1500
    },
    "builtin": {
      "master": {
        "qq": 0,
        "name": "主人"
      },
      "coffee": {
        "dailyQuota": 3,
        "refillSimHour": 8
      }
    },
    "qq": {
      "runtime": "napcat",
      "selfId": 0,
      "dbPath": "data/modules/napcat.db",
      "memeDir": "data/modules/memes",
      "sendMinIntervalMs": 2500,
      "sendJitterMs": 1500
    }
  },
  "state": {
    "vars": {
      "fatigue": {
        "min": 0,
        "max": 100,
        "init": 30
      },
      "mood": {
        "min": -100,
        "max": 100,
        "init": 10
      },
      "annoyance": {
        "min": 0,
        "max": 100,
        "init": 0
      },
      "stress": {
        "min": 0,
        "max": 100,
        "init": 10
      },
      "social": {
        "min": 0,
        "max": 100,
        "init": 80
      }
    },
    "rules": {
      "fatiguePerSimHourAwake": 3.5,
      "fatiguePerTurn": 0.2,
      "fatigueRecoveryPerSimHour": 10,
      "annoyanceDecayPerSimHour": 2,
      "annoyancePerAlarmRing": 9,
      "annoyancePerStormTick": 4,
      "stressDecayPerSimHour": 1.5,
      "socialRecoveryPerSimHourAlone": 2,
      "socialPerMessageIntensity": 0.3,
      "socialPerSocialTool": 6,
      "pulseWindowSimMinutes": 10,
      "maxPerceptionIntensityPerWindow": 6,
      "maxSocialToolsPerWindow": 2,
      "moodRegressionToBaselinePerSimHour": 0.3,
      "moodBaseline": 10
    },
    "thresholds": {
      "drowsyInject": 45,
      "drowsyTier2": 65,
      "drowsyTier3": 78,
      "forcedSleep": 90,
      "naturalWake": 22,
      "drowsyOnWake": 32,
      "sleepHardCapSimMinutes": 720,
      "alarmRingIntervalSimMinutes": 10,
      "stormWindowSimMinutes": 3,
      "stormMinMentions": 5,
      "feelingRepeatCooldownSimMinutes": 45
    }
  },
  "loop": {
    "heartbeatSimMinutes": 20,
    "emptyBackoffBaseSimMinutes": 30,
    "emptyBackoffMaxSimMinutes": 180,
    "perceptionFlushDelayMs": 4000,
    "hotTailMessages": 40,
    "contextWindowCap": 64000
  },
  "memory": {
    "dataDir": "data",
    "memoryFile": "data/MEMORY.md",
    "diaryDir": "data/memories",
    "consolidateDiaryDaysToWeek": 7
  },
  "sleep": {
    "wakeOnStorm": true,
    "maxSnoozeBeforeForcedWake": 3,
    "minFatigueToSleep": 28,
    "wakeOnPrivateMessage": true,
    "privateWakeMessages": 4,
    "privateWakeWindowSimMinutes": 10,
    "masterPrivateWakeMessages": 2
  },
  "panel": {
    "enabled": true,
    "port": 8080,
    "tokenEnv": "WATCHING_BOT_PANEL_TOKEN"
  },
  "judge": {
    "enabled": true,
    "cooldownSimMinutes": 30,
    "maxCallsPerSimDay": 6
  }
}
