# ---- 必填 ----
# 模型 API key(或把 config/default.json 的 model.apiKeyEnv 指向你自己的变量名)
WATCHING_BOT_API_KEY=

# 面板访问口令:留空 = 不鉴权,只适合本机开发;一键安装脚本会自动生成随机值
WATCHING_BOT_PANEL_TOKEN=

# ---- 常用可选 ----
# 模拟时间倍率
WATCHING_BOT_TIMESCALE=1
# 主人 QQ(喝完咖啡会去找这个号讨)
WATCHING_BOT_MASTER_QQ=0

# 面板监听地址(默认 127.0.0.1;端口在 config/default.json 的 panel.port,默认 9981)
WATCHING_BOT_PANEL_HOST=127.0.0.1

# ---- QQ OneBot(本机运行时) ----
# NapCat / SnowLuma 以独立进程跑在本机,默认连 ws://127.0.0.1:3001
# NAPCAT_URL=ws://127.0.0.1:3001
# SNOWLUMA_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=
SNOWLUMA_TOKEN=
# NapCat 的 webui.json 路径(面板读取/展示 WebUI token 用)
# NAPCAT_WEBUI_CONFIG=runtime/napcat-node/napcat/config/webui.json
# NAPCAT_WEBUI_TOKEN=

# ---- 联网搜索(可选) ----
# SearXNG 实例(需启用 json 格式);本机直跑用 127.0.0.1
# WATCHING_BOT_SEARXNG_URL=http://127.0.0.1:10099
# DeepSeek 搜索端点 key(也可在面板 Builtin → 联网搜索里填)
# DEEPSEEK_API_KEY=sk-...
# WATCHING_BOT_SEARCH_API_KEY=
