# ---- 必填 ----
# 模型 API key(或把 config/default.json 的 model.apiKeyEnv 指向你自己的变量名)
WATCHING_BOT_API_KEY=

# 面板访问口令:留空 = 不鉴权,只适合本机开发
WATCHING_BOT_PANEL_TOKEN=

# runtime supervisor 的内部 secret(等价于 Docker 高权限,务必用长随机串)
WATCHING_BOT_SUPERVISOR_TOKEN=

# ---- 常用可选 ----
# 模拟时间倍率
WATCHING_BOT_TIMESCALE=1
# 主人 QQ(喝完咖啡会去找这个号讨)
WATCHING_BOT_MASTER_QQ=0

# 面板监听地址(容器内需要 0.0.0.0;本机建议 127.0.0.1)
WATCHING_BOT_PANEL_HOST=127.0.0.1

# ---- QQ OneBot ----
# 有 supervisor 时默认走内网别名 ws://napcat:3001 / ws://snowluma:3001
# 本地直连可显式指定:
# NAPCAT_URL=ws://127.0.0.1:3001
# SNOWLUMA_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=
SNOWLUMA_TOKEN=
