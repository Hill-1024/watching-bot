{
  "name": "watching-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-looping persona bot: hidden state machine + sleep/wake scheduler over a pi agent core, capabilities plugged in via a module bus.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock:openai": "tsx tools/mock-openai-server.ts",
    "mock:onebot": "tsx tools/mock-onebot-server.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "typebox": "^1.3.27",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
