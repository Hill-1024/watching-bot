{
  "name": "watching-bot",
  "version": "0.2.0",
  "private": true,
  "author": "Hill-1024",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Self-looping persona bot: hidden state machine + sleep/wake scheduler over a pi agent core, capabilities plugged in via a module bus.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock:openai": "tsx tools/mock-openai-server.ts",
    "mock:onebot": "tsx tools/mock-onebot-server.ts",
    "electron": "node scripts/ensure-electron.mjs && electron .",
    "dev:desktop": "node scripts/dev-electron.mjs",
    "electron:install": "node scripts/ensure-electron.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:server": "node scripts/prepare-electron-server.mjs",
    "fetch:node": "node scripts/fetch-node-runtime.mjs",
    "dist:win": "npm run fetch:node && npm run prepare:server && electron-builder --win --x64",
    "dist:linux": "npm run fetch:node && npm run prepare:server && electron-builder --linux --x64",
    "dist:mac": "npm run fetch:node && npm run prepare:server && electron-builder --mac"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "typebox": "^1.3.27",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.13",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vue": "^3.5.44"
  }
}
